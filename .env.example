# Mationary — environment placeholders.
# Copy to .env.local for local development. Never commit real values.
#
# Public site URL (used for canonical + Open Graph URLs).
NEXT_PUBLIC_SITE_URL=https://mationary.com

# --- Intake form delivery (Resend) ---
# Required in Production, or the form returns an error instead of confirming.
# API key from https://resend.com/api-keys — server-side only, never NEXT_PUBLIC_.
RESEND_API_KEY=
# Sender. Must be on a domain verified in Resend (SPF + DKIM), not a free inbox.
INTAKE_FROM_EMAIL=Mationary <intake@mationary.com>
# Recipient. Defaults to site.contactEmail when unset.
INTAKE_TO_EMAIL=hello@mationary.com

# --- Not wired up yet. Reserved for future integrations. ---
# Scheduling / booking provider
# NEXT_PUBLIC_BOOKING_URL=
# Payments (Stripe) — do not enable until payment flow is approved
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Analytics
# NEXT_PUBLIC_ANALYTICS_ID=
